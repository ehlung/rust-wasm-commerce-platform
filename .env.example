# PostgreSQL 접속 정보는 실제 .env 또는 배포 환경의 Secret에만 설정합니다.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require
PG_TLS_INSECURE=false

# MSA 서비스별 접속정보. 개발 환경에서는 같은 DB URL을 사용할 수 있지만,
# 운영 환경에서는 각 스키마에 최소권한을 가진 서로 다른 계정을 권장합니다.
CATALOG_DATABASE_URL=postgresql://CATALOG_USER:PASSWORD@HOST:5432/DATABASE?sslmode=require
ORDER_DATABASE_URL=postgresql://ORDER_USER:PASSWORD@HOST:5432/DATABASE?sslmode=require

# monolith | gateway | catalog | order
RUNNER_MODE=monolith
APP_ADDR=127.0.0.1:8091

# MSA 모드의 내부 서비스 주소
CATALOG_URL=http://127.0.0.1:8092
ORDER_URL=http://127.0.0.1:8093
COMPONENT_DIR=target/wasm32-wasip2/release
RUST_LOG=info
