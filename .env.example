# 개인 PostgreSQL 또는 허가받은 테스트 DB의 접속 문자열을 로컬 .env에만 작성합니다.
DATABASE_URL=postgresql://app_user:change_me@127.0.0.1:5432/app_db?sslmode=require

# 기본값은 인증서와 호스트명을 검증합니다.
# 자체 서명 인증서 또는 IP 불일치가 확인된 격리된 테스트 DB에서만 true로 설정합니다.
# PG_TLS_INSECURE=false

# 외부에는 Nginx를 두고 Host Runner는 loopback에만 바인딩하는 구성을 권장합니다.
APP_ADDR=127.0.0.1:8091

# 컴포넌트 경로는 기본 빌드 위치를 사용할 때 생략할 수 있습니다.
# COMPONENT_DIR=./target/wasm32-wasip2/release
